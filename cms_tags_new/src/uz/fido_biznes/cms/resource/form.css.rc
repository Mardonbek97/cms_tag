BODY{background-color:#eee;font:11px Arial;overflow:auto;modal-background:#EFF2F7;margin:5px 0 5px 5px}
FORM{margin:0;padding:0}
TABLE{font:13px Arial}
TD{vertical-align:text-top}
TH{font-weight:700}
.form{background-color:#6999DA;border:1px solid #24426A;coeff:1}
.panel{overflow-y:scroll;width:100%;float:left;margin:2px}
.panel table{width:96%}
.formTitle{font:bold 13px;color:#fff;padding-left:5px;cursor:default;text-align:center}
.content{background-color:#EFF2F7;border:1px solid #24426A;border-top:2px solid #24426A;width:100%}
.formToolbar{padding-bottom:10px;border-bottom:1px solid #24426A;width:99%}
FIELDSET{border:1px solid #D0D0BF;text-align:left;margin:0 1px;padding:0 5px 3px 10px}
LEGEND{color:#0046DC;font:bold 11px "Trebuchet MS", Tahoma, Verdana, sans-serif;padding:0 1em}
LABEL{text-align:right;padding-right:10px}
INPUT,BUTTON,TEXTAREA,SELECT{button-background:#ccc;button-background-hover:#ddd;button-border:1px solid #7F9DB9;input-border:1px solid #7F9DB9;input-background:#FFF;input-background-focus:#e2efff;input-background-error:#F96;input-background-disabled:#EFF2F7;vertical-align:bottom;margin:0 0 0 4px}
TEXTAREA{overflow:auto}
SELECT{vertical-align:bottom;border:1px dotted #000}
.withFilter{color:#900;font-weight:700}
.mbtn{font:13px Arial;width:19px;height:19px}
.multiple,.multiple td,.multiple th{border:1px solid #919B9C;border-collapse:collapse;text-align:center;margin:2px;padding:2px}
.navbut{font-family:webdings;font-size:13px;height:22px;width:23px;text-align:center;margin:0 1px}
.sysbut{border:solid 1px #000;font-weight:700;font-size:13px;height:22px;width:23px;text-align:center;margin:0 1px}
tr.cellEven{background:#EFF4FA}
tr.cellOdd{background:#EEE}
td.cellCur{background:#99F}
tr.cellSel{background:#CCF}
.cSort{cursor:hand;color:red}
.panel #tbl{width:100%;cursor:default;margin:0}
.panel #tbl THEAD TR{position:relative;top:expression(offsetParent.scrollTop)}
.panel #tbl TH{font:bold 12px;color:#fff;font-family:Arial, sans-serif;background-color:#69C;text-align:center;border:1px solid #d8d8d8;vertical-align:top;padding:2px}
.panel #tbl TD{border:1px solid #d8d8d8;padding:2px}
.rpp{input-background:#EFF2F7;text-align:center;font:bold 12px}
.tp{input-background:#EFF2F7;text-align:left;font:bold 12px;input-border:1px solid #EFF2F7;margin-right:5px;margin-left:0}
span.counter{background-color:#DFE9EF;width:25px;height:18px;text-align:center}
span.counterhide{background-color:#EFF2F7;color:#EFF2F7;width:25px;height:18px}
div.locklayer{position:absolute;z-index:10;overflow:hidden;text-align:center;display:none;background:#F5F6F8;filter:alpha(opacity=50)}
div.locklayer iframe{width:100%;height:100%;position:absolute;top:0;left:0;display:block;z-index:-1;filter:mask()}
q{color:red;quotes:none}
q:before,q:after{content:''}
optgroup{color:#CD5C5C}
option{color:#000}
table.Menu{position:absolute;z-index:11;color:#000;cursor:default;border:2px outset #fff;background:#F9F8F7}
td.MenuItem{border:1px solid #F9F8F7}
td.MenuItemHover{background-color:#C6D3EF;border:1px solid #3169C6}
td.MenuSeparator{border-bottom:1px solid #666;font-size:1px}
td.MenuArrow{text-align:right;font:11px Webdings;color:#CD5C5C}
span.tab{line-height:30px;cursor:default;background-hover:#F1EFED;border-inset:1px inset #FFF;border-outset:1px outset #FFF;border:1px solid #EBE9E6;padding:3px 8px}
TD.menuBlock{font:normal 13px Tahoma,Verdana,sans-serif;color:#000;background:#EBE9E6;border-color:#369;border-style:double;border-width:3px 0}